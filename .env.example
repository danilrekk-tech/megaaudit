# ==========================================================
# Mega.Audit — переменные окружения
# ==========================================================
# PUBLIC — попадают в собранный фронтенд (можно публиковать)
# ==========================================================

# Адрес бэкенда для внешней сборки (Yandex Object Storage).
# Пусто/не задано — фронтенд и бэкенд на одном домене (сборка Lovable).
# Для Yandex укажите домен, где работает существующий бэкенд:
VITE_API_BASE_URL=https://megaaudit.lovable.app

# ==========================================================
# SECRET — только на сервере, НИКОГДА не в сборке фронтенда
# ==========================================================

# Дополнительные origin'ы, которым разрешены запросы к /api/public/*
# (через запятую). Домены Lovable разрешены по умолчанию.
ALLOWED_ORIGINS=https://megaaudit.website.yandexcloud.net

# Учётные данные Yandex Object Storage — только в GitHub Secrets,
# никогда в репозитории и никогда во фронтенде.
# YC_ACCESS_KEY_ID=
# YC_SECRET_ACCESS_KEY=
# YC_BUCKET=
